{
  "name": "riemann-playground",
  "private": true,
  "version": "1.0.0",
  "description": "An interactive, step-by-step explanation of the Riemann hypothesis.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint . && stylelint \"src/**/*.css\" && prettier --check .",
    "lint:html": "html-validate dist/index.html",
    "format": "prettier --write . && stylelint --fix \"src/**/*.css\" && eslint --fix .",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "html-validate": "^11.21.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "i18next": "27.0.1",
    "i18next-browser-languagedetector": "8.3.0"
  }
}
